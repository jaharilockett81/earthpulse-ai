# Copy to .env (never commit .env). Only QLOO_API_KEY is required.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: lets an LLM parse free-text requests and reword explanations (validated, no new numbers).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Abuse protection for the public demo
RUNS_PER_HOUR_PER_IP=20
SEARCH_PER_10MIN_PER_IP=120

# Local UI work without a key: serves clearly-labelled SYNTHETIC places. Refused when ENVIRONMENT=production.
ENVIRONMENT=development
EARTHPULSE_DEV_FIXTURES=0
